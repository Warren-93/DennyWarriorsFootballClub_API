# Environment variables for the Denny Warriors API.
#
# This file lists names only. Never put real values here: this repository is
# public. Set the real values in Render (service > Environment), or for local
# development copy this file to .env, which git ignores.

# --- Required ---------------------------------------------------------------

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Signs admin login tokens. At least 32 random characters.
# Generate one with: openssl rand -base64 48
DWFC_JWT_SECRET=

# Scottish FA Comet report URLs, including their API_KEY parameter.
COMET_FIXTURES_URL=
COMET_STANDINGS_URL=

# Password for the first admin account. Only used when the users collection
# is empty. Required while DWFC_ADMIN_BOOTSTRAP_ENABLED is true (the default).
DWFC_ADMIN_PASSWORD=

# --- Optional (defaults shown) ----------------------------------------------

# DWFC_ALLOWED_ORIGINS=http://localhost:3000,https://denny-warriors-football-club.vercel.app
# DWFC_ADMIN_BOOTSTRAP_ENABLED=true
# DWFC_ADMIN_USERNAME=admin
# SPRING_PROFILES_ACTIVE=prod
