# Lombok conventions for this API (see "Lombok conventions" in README.md).
config.stopBubbling = true

# Mark generated code so coverage tools (JaCoCo) skip it.
lombok.addLombokGeneratedAnnotation = true

# @AllArgsConstructor on wide models is easy to call with arguments in the
# wrong order. Prefer setters, or @Builder if a model ever needs one.
lombok.allArgsConstructor.flagUsage = WARNING
