# Environment variables for the club API.
#
# Names only: never put real values in this file. Set real values in your
# hosting platform's environment settings, or copy this file to .env for
# local development (git ignores .env).

# --- Required ---------------------------------------------------------------

# MongoDB connection string including the database name. docker-compose.yml
# sets this for you locally.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Signs login tokens. At least 32 random characters:
#   openssl rand -base64 48
JWT_SECRET=

# Password for the first admin account (12+ characters). Only used while the
# users collection is empty; set ADMIN_BOOTSTRAP_ENABLED=false afterwards.
ADMIN_PASSWORD=

# --- The club (defaults shown) ----------------------------------------------

# Exactly as the league data spells it (case-insensitive).
# CLUB_NAME=Example FC
# CLUB_TIMEZONE=Europe/London
# POINTS_FOR_WIN=3
# POINTS_FOR_DRAW=1
# POINTS_FOR_LOSS=0

# Comma-separated browser origins allowed to call the API (the frontend).
# ALLOWED_ORIGINS=http://localhost:3000

# --- League data ------------------------------------------------------------

# "manual" (enter fixtures/results/table in the admin panel) or "comet".
# LEAGUE_PROVIDER=manual
# LEAGUE_SYNC_ENABLED=true

# Only for LEAGUE_PROVIDER=comet. Full report URLs including API_KEY.
# COMET_FIXTURES_URL=
# COMET_STANDINGS_URL=

# --- Optional ---------------------------------------------------------------

# YouTube channel id (starts with UC). Blank turns the videos endpoint off.
# YOUTUBE_CHANNEL_ID=
# ADMIN_USERNAME=admin
# ADMIN_BOOTSTRAP_ENABLED=true
# LOGIN_RATE_LIMIT_ENABLED=true
# LOGGING_LEVEL_HTTP=INFO
# SPRING_PROFILES_ACTIVE=prod
