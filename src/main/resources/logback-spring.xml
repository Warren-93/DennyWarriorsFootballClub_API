<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Local/dev/test: keep the existing compact, colourised console pattern
         (still driven by the logging.pattern.console property). -->
    <springProfile name="!prod">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    </springProfile>

    <!-- Production (SPRING_PROFILES_ACTIVE=prod on Render): one JSON object per
         line, so Render's log stream / any downstream log search can filter on
         fields (level, logger, message, thread) instead of grepping text. -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"denny-warriors-api"}</customFields>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
